# OS / Editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# Environment / secrets
.env
.env.*
!.env.example
*.local

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/.npm/
frontend/.pnpm-store/
frontend/coverage/
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*

# Python / backend
backend/__pycache__/
backend/**/*.pyc
backend/.pytest_cache/
backend/.mypy_cache/
backend/.ruff_cache/
backend/.coverage
backend/htmlcov/
backend/.venv/
backend/venv/

# Python caches outside backend/ (running the validation evidence
# under .agents/rules/_validation/ leaves a __pycache__ behind)
.agents/**/__pycache__/
.agents/**/*.pyc

# Build / runtime artifacts
*.pid
*.seed
*.out
*.err

# Docker
*.tar
